// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run the `open default settings` command
// from the command palette or from `Zed` application menu.
{
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "global_lsp_settings": {
    "button": false
  },
  "proxy": "",
  "document_folding_ranges": "off",
  "semantic_tokens": "combined",
  "redact_private_values": true,
  // Default value
  // "private_files": ["**/.env*", "**/*.pem", "**/*.key", "**/*.cert", "**/*.crt", "**/secrets.yml"]
  "cli_default_open_behavior": "new_window",
  "project_panel": {
    "dock": "left",
  },
  "outline_panel": {
    "dock": "left",
  },
  "collaboration_panel": {
    "dock": "left",
  },
  "git_panel": {
    "tree_view": false,
    "dock": "left",
  },
  "file_finder": {
    "file_icons": true,
    // this defaults to "small", and that's a fixed narrow width that truncates long paths
    // options are small, medium, large, xlarge, full
    //
    // NOTE: this is _only_ for the file_finder, not the other modals (like
    // command palette and project symbols)
    "modal_max_width": "medium",
    // I do sometimes what some things that are gitignored, but with some of my
    // projects, "all" would just suck.
    //
    // Another choice is "indexed", which is never show ignored
    // "smart" means show the files when the a worktree's root is ignored
    "include_ignored": "smart",
  },
  "disable_ai": false,
  "git": {
    "blame": {
      // this is only for the gutter, not end-of-line inline blame (which has no avatar)
      "show_avatar": false,
    },
    "inline_blame": {
      "enabled": true,
      "show_commit_summary": false,
    },
  },
  "use_smartcase_search": true,
  // ruby-lsp rather than solargraph, which is the extension's default. Both are
  // gems, so either has to exist for whichever ruby a project's .ruby-version
  // names — see ruby/bin/ruby-lsp-install in the dotfiles. ruby-lsp is the one
  // that composes its own bundle instead of wanting a Gemfile entry per project,
  // which is why use_bundler has to be off: left on it runs `bundle exec ruby-lsp`
  // and bundler correctly reports a gem that was never meant to be in the bundle.
  // The list is closed — no "..." — because that wildcard re-enables every Ruby
  // server any installed extension registers, and none of the others are installed.
  "languages": {
    "Ruby": {
      "language_servers": ["ruby-lsp"],
    },

    // This is actually a default, and then Zed turns it back off for Markdown
    // so a two-space hard line break can stay around. No thanks.
    "Markdown": {
      "remove_trailing_whitespace_on_save": true,
    },
  },
  "lsp": {
    "ruby-lsp": {
      "initialization_options": {
        "featuresConfiguration": {
          // for whatever reason, ruby-lsp has every inlay hint off by default
          // but I want 'em
          //
          // as of this writing, there are only two hints, but I want more if
          // they show up …unless they turn out to be annoying, in which case
          // I'll turn them off
          "inlayHint": {
            "enableAll": true,
          },
        },
      },
      "settings": {
        "use_bundler": false,
      },
    },
  },
  "inlay_hints": {
    "enabled": true,
    // let me turn the hints off, temporarily
    "toggle_on_modifiers_press": {
      "control": true,
      "alt": true,
    },
  },
  "show_whitespaces": "trailing",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware",
  },
  "vim": {
    "use_smartcase_find": true,
    "toggle_relative_line_numbers": false,
  },
  "minimap": {
    "show": "auto",
  },
  // I want to see how brackets match up. Also, pretty colors.
  "colorize_brackets": true,
  "linked_edits": true,
  "diagnostics": {
    "inline": {
      "enabled": true,
    },
  },
  // Can you believe the default is "one_page"? Why would I want that?
  // This gives just a little bit of space, rather than no scroll at all.
  "scroll_beyond_last_line": "vertical_scroll_margin",
  "sticky_scroll": {
    "enabled": true,
  },
  "which_key": {
    "enabled": true,
    // tried 1000ms, and that felt too long
    "delay_ms": 400,
  },
  "relative_line_numbers": "disabled",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "One Dark",
  },
  "buffer_font_family": "Fira Code",
  "buffer_font_features": {
    // this is a default, but I want it explicit
    // ligatures are good
    "calt": true,
    // more-specific options go here, if I want them
    // I currently don't
  },
  "vim_mode": true,
  "ui_font_size": 16,
  "buffer_font_size": 16,
}
