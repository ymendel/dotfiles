#!/usr/bin/env bash
#
# Install a ruby and give it a language server in the same breath.
#
# ruby-install has no post-install hook — 0.10.1 offers nothing but
# -- CONFIGURE_OPTS — so joining the two steps has to happen out here, in something
# I run instead of ruby-install. Which is the point: the trigger is the thing I was
# going to do anyway, rather than a second command to remember afterwards.
#
# Anything after the version goes through to ruby-install, which is enough for the
# -- CONFIGURE_OPTS form. ruby-install takes its own options before the version, so
# for those call ruby-install directly and follow it with ruby-lsp-install.
#
# Ruby only, since the engine is hardcoded. `ruby-add jruby-9.4` would ask
# ruby-install for a ruby of that version rather than for jruby.
set -uo pipefail

source "$DOTFILES_HOME/script/helpers/printing.sh"

version="${1:-}"

if [[ -z $version ]]
then
    fail 'usage: ruby-add VERSION [-- CONFIGURE_OPTS ...]'
fi

shift

# ruby 4.0.x won't build on macOS 26 against the macOS 27 SDK. configure decides
# dup3 and pipe2 are there, they come out weakly linked and NULL at runtime, and
# miniruby segfaults the moment the build runs it to make builtin_binary.rbbin.
# Seeding the autoconf cache stops configure defining them.
# https://bugs.ruby-lang.org/issues/22311
#
# Drop these once a ruby release carries the fix. 4.0.7 doesn't.
export ac_cv_func_dup3=no ac_cv_func_pipe2=no

# --no-reinstall so that re-running for a ruby already on disk is a no-op rather
# than a rebuild, which matches how ruby-lsp-install behaves.
if ! ruby-install --no-reinstall ruby "$version" "$@"
then
    fail "ruby-install did not finish for $version"
fi

ruby-lsp-install "ruby-$version"
