#!/usr/bin/env bash
#
# Put ruby-lsp into a ruby, because a gem belongs to exactly one of them.
#
# Zed spawns a login shell in the project's directory and uses that shell's
# environment to find and start a language server, so chruby_auto picks whatever
# the project's .ruby-version asks for and ruby-lsp has to already be there. A copy
# installed under a different ruby is not merely unused, it is invisible: compiled
# extensions live under a per-ruby api directory, and since ruby-install builds
# without --enable-shared while Homebrew builds with it, even two installs calling
# themselves 4.0.6 disagree about which directory that is.
#
# That is only how it resolves with use_bundler off. Left on (its default) the
# extension runs `bundle exec ruby-lsp` without first checking that the gem is in
# the bundle, meaning any project with a Gemfile (uh, all of them?) fails with bundler's
# own "command not found: ruby-lsp" and never consults PATH at all. The docs describe a
# fallback to PATH and then to a global install, but that cascade needs the extension
# built with its command_api feature, and the shipped build is not.
#
# ruby-lsp is deliberately not a Gemfile entry — it composes its own bundle to see
# a project's gems, so this is the only install it gets, and that is exactly why
# use_bundler *has* to be off (as opposed to just preferably off).
#
# The actual editor config has to be in ~/.config/zed/settings.json, and that is
# currently untracked. For reasons. Zed's Ruby extension reaches for solargraph unless
# told otherwise, so the config has to also have this added.
#
#     "languages": {
#       "Ruby": {
#         "language_servers": ["ruby-lsp"],
#       },
#     },
#     "lsp": {
#       "ruby-lsp": {
#         "settings": {
#           "use_bundler": false,
#         },
#       },
#     },
#
#
# Zed's documentation says to turn off solargraph and leave "..." in there, but what
# that means in practice is that all the other servers registered for Ruby — kanayago
# steep, sorbet, fuzzy-ruby-server — are still active and not installed. And then each
# one reports its own failure. Just make this explicitly only ruby-lsp, and revisit
# this if more are wanted later.
#
# Fortunately, ruby-lsp handles rubocop on its own, so not only is it not necessary to
# add a rubocop server, it'd actually be detrimental because ruby-lsp handles this better
# and more intelligently. (It pays attenton to whether rubocop is even part of the project,
# for instance.)
#
# With no arguments it uses the ruby chruby has active. Name one or more versions
# to install elsewhere. Already-installed rubies are skipped, so re-running is free.
set -uo pipefail

source "$DOTFILES_HOME/script/helpers/printing.sh"

rubies=("$@")

if [[ ${#rubies[@]} -eq 0 ]]
then
    if [[ -z ${RUBY_ROOT:-} ]]
    then
        fail "no ruby active and none named — that would land in Homebrew's ruby, which is the thing to avoid"
    fi

    rubies=("${RUBY_ROOT##*/}")
fi

for ruby in "${rubies[@]}"
do
    # The exit status is the answer here, not the output — and a gem command will
    # cheerfully prepend warnings about whatever else the ruby has lying around,
    # which was a screenful of rdoc redefinitions until that got cleaned up.
    if chruby-exec "$ruby" -- gem list --installed --exact ruby-lsp > /dev/null 2>&1
    then
        success "ruby-lsp is already in $ruby"
        continue
    fi

    info "installing ruby-lsp into $ruby"

    if chruby-exec "$ruby" -- gem install ruby-lsp > /dev/null
    then
        success "installed ruby-lsp into $ruby"
    else
        warn "could not install ruby-lsp into $ruby"
    fi
done
