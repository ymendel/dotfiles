export DOTFILES_HOME="$HOME/.dotfiles"

# source all .bash files nested anywhere in the dotfiles
for f in $(find -H "$DOTFILES_HOME" -name '*.bash' -type f | sort)
do
  source "$f"
done

# pull in the local settings only for this machine
# (or the stuff that shouldn't be tracked publicly)
#
# specifically using this `if` rather than the `&&` I had before.
# As it turns out, the `&&` left behind the 1 exit status if
# ~/.local/bashrc was missing, and that's not always necessary.
for f in local/bashrc
do
  if [[ -f ~/.$f ]]
  then
    source ~/.$f
  fi
done
