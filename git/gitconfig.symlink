# vim: set filetype=gitconfig:
[user]
	name = Yossef Mendelssohn
	email = ymendel@pobox.com
# Per-directory identity override (add to local config and adjust per machine).
# Use `gitdir/i:` (case-insensitive) — macOS filesystems will bite you otherwise.
# Trailing slash matters: `gitdir/i:~/clients/acme/` matches any repo under that
# directory; without the slash it's an exact match on the .git path.
# Symlink gotcha: the path matched is whatever git actually sees as $GIT_DIR —
# i.e. the path you used to reach the repo, not the canonical resolved target.
# If you cd in via a symlinked path, write the includeIf to match the symlinked
# form (or canonicalize the path you cd through).
# [includeIf "gitdir/i:~/clients/acme/"]
# 	path = ~/clients/acme/.gitconfig
# Then ~/clients/acme/.gitconfig contains:
# 	[user]
# 		email = you@acme.example
[alias]
	aliases = !git config --list | grep 'alias.' | sed 's/^alias.//' | sed 's/=/ => /'
	ci = commit
	cia = !git add --all && git commit --all
	cie = commit --allow-empty
	astc = commit --amend --no-edit
	aatc = !git add --all && git commit --all --amend --no-edit
	co = checkout
	conflicts = diff --diff-filter=U
	conflicted = diff --name-only --diff-filter=U
	staged = diff --cached
	pending = diff --cached
	unstage = reset HEAD
	uncommit = reset --soft HEAD^
	rmcommit = reset HEAD^
	unstash = stash pop
	rmstash = stash drop
	showstash = stash show -p
	shoe = show --ext-diff
	undo = !sh -c 'git revert --no-commit ${1:-HEAD}' -
	export = !sh -c 'git clone --depth 1 $1 && rm -fr `expr \"$1\" : \".*[:/]\\([a-zA-Z_]*\\).git\"`/.git' -
	x = !gitx
	hack = !hack
	ship = !ship
	deleted = log --oneline --diff-filter=D --
	# numbered from 0 so I can see what N is for HEAD~N
	# it's not perfect for all cases, hence the plain number
	# and not something more, like "HEAD~N"
	logd = !sh -c 'git log --oneline --decorate --color=always \"$@\" | nl -b a -v 0 -w 3 -s \"  \"' -
	logg = log --graph --pretty=format:'%C(yellow)%h%C(reset) -%C(cyan)%d%C(reset) %s %Cgreen(%cr) %C(bold blue)<%an>%C(reset)' --abbrev-commit --date=relative
	bw = branch --contains
	diffw = diff --word-diff
	fixup = commit --fixup
	squash = commit --squash
	amend = commit --amend
	reword = commit --only --amend
	redact = filter-branch
	retcon = filter-branch
	setup = !sh -c 'git clone $1 && cd `expr \"$1\" : \".*[:/]\\([a-zA-Z_]*\\).git\"` && git checkout -b work' -
	top = rev-parse --show-toplevel
	ctags = !~/.dotfiles/git/template/hooks/ctags
	st = status
	sts = status --short --branch --untracked-files=all
	stat = !git diff --stat $(git merge-base HEAD \"$REVIEW_BASE\")
	files = !git diff --name-only $(git merge-base HEAD \"$REVIEW_BASE\")
	fetch-branch = !bash -ic 'git_fetch_branch ${1:-$(git_current_branch)}' -
	fetch-branch-force = !bash -ic 'git_fetch_branch ${1:-$(git_current_branch)} force' -
	fb = fetch-branch
	fbf = fetch-branch-force
	pushf = push --force-with-lease
	pf = pushf
	# the quotes are so `;` works as command sequencing and not a config comment
	push-other-branch = "!sh -c 'b=${1:?branch name required}; shift; git push \"$@\" origin \"$b:$b\"' -"
	pob = push-other-branch
	re-main = !git fetch-branch $MAIN_BRANCH
	re = !git re-main
	main = !git checkout $MAIN_BRANCH
	rebase-main = !git rebase $MAIN_BRANCH
	rem = !git rebase-main
	rec = rebase --continue
	rea = rebase --abort
	ri = rebase --interactive
	ria = rebase --interactive --autosquash
	rim = !git rebase --interactive $MAIN_BRANCH
	riam = !git rebase --interactive --autosquash $MAIN_BRANCH
	mem = !git merge $MAIN_BRANCH
	pause = !git add --all && git commit --all --no-verify --message 'PAUSED: Use `git resume` to continue working.'
	paused = !git log -1 --format="%s" | grep -q '^PAUSED: '
	resume = !git paused && git rmcommit
	merged = !sh -c 'git merge-base --is-ancestor ${1:-HEAD} ${2:-$MAIN_BRANCH}' -
	clean-merged = !git branch --merged $MAIN_BRANCH --format='%(refname:short)' | grep -v "^${MAIN_BRANCH}$" | xargs git branch -d
	branch-exists = show-ref --quiet --heads
	blame-with-subject = !bash -ic 'git_blame_with_subject $*' -
	bws = blame-with-subject
	blame-follow = blame -w -C -C -C
	spelunk = blame-follow
[pager]
	# shell aliases don't paginate on their own
	logd = true
[color]
	status = auto
	diff = auto
	branch = auto
	interactive = auto
[color "status"]
	added = yellow
	changed = green
	untracked = cyan
[github]
	user = ymendel
	password = !security 2>&1 >/dev/null find-generic-password -gs github.password | ruby -e 'print $1 if STDIN.gets =~ /^password: \\\"(.*)\\\"$/'
[hub]
	protocol = https
[credential]
	helper = osxkeychain
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[fetch]
	prune = true
[pull]
	rebase = false
[rebase]
	autoStash = true
[rerere]
	enabled = true
[diff]
	external = difft
[merge]
	conflictStyle = diff3
	tool = vim_mergetool
[mergetool "vim_mergetool"]
	cmd = vim -f -c "MergetoolStart" "$MERGED" "$BASE" "$LOCAL" "$REMOTE"
	trustExitCode = true
[status]
	showUntrackedFiles = all
[core]
	excludesfile = ~/.gitignore
[credential "https://git.heroku.com"]
	helper = !heroku git:credentials

# an include only overrides what's above it, so everything up to here is
# fair game for a machine to change
[include]
	path = ~/.gitconfig.local
	path = ~/.local/gitconfig

# and anything below it can't be. hooksPath lives here on purpose: it points
# into these dotfiles, which are the same everywhere, and a local override
# would fail silently — hooks would just quietly stop running.
# a repo's own .git/config still wins, so per-project hooks are unaffected.
# don't tidy this back up into the [core] above.
[core]
	hooksPath = ~/.dotfiles/git/template/hooks
